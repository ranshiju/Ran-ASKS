LLM_API_BASE=
LLM_API_PATH=/v1/chat/completions
LLM_API_KEY=
# Choose the ingestion LLM; no particular brand or model is required.
LLM_MODEL=
INGEST_GENERATION_API_BASE=${LLM_API_BASE}
INGEST_GENERATION_API_KEY=${LLM_API_KEY}
INGEST_GENERATION_MODEL=${LLM_MODEL}
INGEST_PROPOSITION_API_BASE=${INGEST_GENERATION_API_BASE}
INGEST_PROPOSITION_API_KEY=${INGEST_GENERATION_API_KEY}
INGEST_PROPOSITION_MODEL=${INGEST_GENERATION_MODEL}

# Choose the recovery subagent LLM; use its provider's base/key if different.
SEMANTIC_RECOVERY_API_BASE=${LLM_API_BASE}
SEMANTIC_RECOVERY_API_KEY=${LLM_API_KEY}
SEMANTIC_RECOVERY_MODEL=

EMBED_API_BASE=${LLM_API_BASE}
EMBED_API_PATH=/v1/embeddings
EMBED_API_KEY=${LLM_API_KEY}
EMBED_MODEL=
