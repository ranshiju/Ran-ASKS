# 默认由当前 Codex agent 接管；切换外部单一模型时改为 api。
QUERY_BACKEND=agent
# ingest 默认由当前 agent 执行；可选 api（外部 LLM 全自动）。
INGEST_BACKEND=agent
# PDF 摄入建议配置免费的 MinerU API token，以提高 Markdown 与公式提取质量。
MINERU_API_TOKEN=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=GLM-5.3-Flash
# 视觉产物 QA（图片/PDF 页/PPT 页）；默认主模型与回退模型来自模型目录。
# raw/inbox/private 路径与 paper-profile PDF 仍须显式 allow_remote；配置 API 不会绕过保护。
VISUAL_QA_API_BASE=${LLM_API_BASE}
VISUAL_QA_API_KEY=${LLM_API_KEY}
VISUAL_QA_MODEL=GLM-4.6V
VISUAL_QA_FALLBACK_MODEL=GLM-4.5V
# 长文本生成专用模型（含 Meeting Compiler 的 wiki/slots）；配置不完整时回退主模型。
INGEST_GENERATION_API_BASE=${LLM_API_BASE}
INGEST_GENERATION_API_KEY=${LLM_API_KEY}
INGEST_GENERATION_MODEL=GLM-5.3-Flash
# 短 JSON 命题抽取：默认 GLM-5.3-Flash + fast reasoning；未配置时复用 generation。
INGEST_PROPOSITION_API_BASE=${INGEST_GENERATION_API_BASE}
INGEST_PROPOSITION_API_KEY=${INGEST_GENERATION_API_KEY}
INGEST_PROPOSITION_MODEL=GLM-5.3-Flash

# Optional future SemanticRecoveryAgent override. Current policy inherits LLM_MODEL.
# SEMANTIC_RECOVERY_API_BASE=${LLM_API_BASE}
# SEMANTIC_RECOVERY_API_KEY=${LLM_API_KEY}
# SEMANTIC_RECOVERY_MODEL=GLM-5.3-Flash
# Embedding API（与 LLM 同源，复用 base/key）
EMBED_API_BASE=${LLM_API_BASE}
EMBED_API_KEY=${LLM_API_KEY}
EMBED_MODEL=GLM-Embedding-3
# API 推理档位：程序按任务与校验结果在 fast/standard/deep/xdeep 间自适应选择。
# 输出 token 与重试预算由调用方独立控制；档位不会改写它们。
LLM_REASONING_DEFAULT=
# GLM-5.3-Flash 当前 endpoint 已验证 reasoning_effort 只接受 low/high，不接受 medium。
LLM_REASONING_FIELD=reasoning_effort
LLM_REASONING_EFFORT_FAST=low
LLM_REASONING_EFFORT_STANDARD=low
LLM_REASONING_EFFORT_DEEP=high
LLM_REASONING_EFFORT_XDEEP=high
