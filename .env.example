# 默认由当前 Codex agent 接管；切换外部单一模型时改为 api。
QUERY_BACKEND=agent
# ingest 默认由当前 agent 执行；可选 api（外部 LLM 全自动）。
INGEST_BACKEND=agent
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
# 视觉产物 QA（图片/PDF 页/PPT 页）；默认主模型与回退模型来自模型目录。
# raw/inbox/private 路径与 paper-profile PDF 仍须显式 allow_remote；配置 API 不会绕过保护。
VISUAL_QA_API_BASE=${LLM_API_BASE}
VISUAL_QA_API_KEY=${LLM_API_KEY}
VISUAL_QA_MODEL=GLM-4.6V
VISUAL_QA_FALLBACK_MODEL=GLM-4.5V
# 长文本生成专用模型（wiki/slots）；配置不完整时回退主模型。
INGEST_GENERATION_API_BASE=${LLM_API_BASE}
INGEST_GENERATION_API_KEY=${LLM_API_KEY}
INGEST_GENERATION_MODEL=MiniMax-M3
# 短 JSON 命题抽取：推荐 MiniMax-M3 + fast reasoning；未配置时复用 generation。
INGEST_PROPOSITION_API_BASE=${INGEST_GENERATION_API_BASE}
INGEST_PROPOSITION_API_KEY=${INGEST_GENERATION_API_KEY}
INGEST_PROPOSITION_MODEL=MiniMax-M3
# Embedding API（与 LLM 同源，复用 base/key）
EMBED_API_BASE=${LLM_API_BASE}
EMBED_API_KEY=${LLM_API_KEY}
EMBED_MODEL=GLM-Embedding-3
# API 推理档位：fast（候选/格式修复）、standard（claims/query）、deep（仅显式请求）。
# 空值时按操作自动选择；档位只收紧 max_tokens/retries，不会放大调用方预算。
LLM_REASONING_DEFAULT=
# 仅当服务端支持思考参数时启用，例如 reasoning_effort + low/medium/high。
LLM_REASONING_FIELD=
LLM_REASONING_EFFORT_FAST=
LLM_REASONING_EFFORT_STANDARD=
LLM_REASONING_EFFORT_DEEP=
